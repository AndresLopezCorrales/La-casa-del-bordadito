<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_sand">

    <!-- ── APPBAR ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_coffee"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/almond_silk"
            app:title="@string/Titulo_qr"
            app:titleTextColor="@color/bone"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brown" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- ── CARD QR ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/silver"
                app:cardBackgroundColor="@color/bone">

                <ImageView
                    android:id="@+id/imgQR"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:background="@color/white"
                    android:padding="20dp"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ── TEXTOS CONFIRMACIÓN ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/Txt_compra_exitosa"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/dark_coffee"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/Txt_escanea_qr"
                android:textSize="13sp"
                android:textColor="@color/stone_brown"
                android:gravity="center" />

            <!-- ── SECTION LABEL ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="DETALLES DEL PEDIDO"
                android:textColor="@color/terracotta"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- ── CARD DETALLES ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_bone"
                android:clipToOutline="true"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Txt_info"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/terracotta"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/silver"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/dark_coffee"
                    tools:text="Detalle de productos..." />

            </LinearLayout>

            <!-- ── BOTÓN SEGUIR COMPRANDO ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeguirComprando"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/Btn_seguir_comprando"
                android:textColor="@color/bone"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="@color/dark_coffee"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_cart"
                app:iconTint="@color/almond_silk"
                app:iconGravity="textStart" />

            <!-- ── BOTÓN IR AL INICIO ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/Btn_ir_inicio"
                android:textColor="@color/stone_brown"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>