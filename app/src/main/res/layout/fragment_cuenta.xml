<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_sand"
    android:fillViewport="true"
    tools:context=".Fragmentos.FragmentCuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <!-- ── TOGGLE NAV ── -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            app:checkedButton="@id/btnNavPerfil"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavPerfil"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Nav_perfil"
                app:backgroundTint="@color/toggle_bg_selector"
                android:textColor="@color/toggle_text_icon_selector"
                app:strokeColor="@color/silver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavConfig"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Nav_config"
                app:backgroundTint="@color/toggle_bg_selector"
                android:textColor="@color/toggle_text_icon_selector"
                app:strokeColor="@color/silver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavAdmin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Nav_admin"
                android:visibility="gone"
                app:backgroundTint="@color/toggle_bg_selector"
                android:textColor="@color/toggle_text_icon_selector"
                app:strokeColor="@color/silver" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ── SECCIONES MODULARIZADAS ── -->

        <include
            android:id="@+id/layoutPerfil"
            layout="@layout/layout_cuenta_perfil"
            android:visibility="visible" />

        <include
            android:id="@+id/layoutConfig"
            layout="@layout/layout_cuenta_config"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutAdmin"
            layout="@layout/layout_cuenta_admin"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>