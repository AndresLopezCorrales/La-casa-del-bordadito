<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_sand"
    android:fillViewport="true"
    tools:context=".Fragmentos.FragmentCuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <!-- ── TOGGLE NAV (UNIFIED SEGMENTED CONTROL) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/silver"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:divider="@drawable/divider_vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/btnNavPerfil"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/Nav_perfil"
                    android:textColor="@color/stone_brown"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnNavConfig"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/Nav_config"
                    android:textColor="@color/stone_brown"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnNavAdmin"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/Nav_admin"
                    android:textColor="@color/stone_brown"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECCIONES MODULARIZADAS ── -->

        <include
            android:id="@+id/layoutPerfil"
            layout="@layout/layout_cuenta_perfil"
            android:visibility="visible" />

        <include
            android:id="@+id/layoutConfig"
            layout="@layout/layout_cuenta_config"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutAdmin"
            layout="@layout/layout_cuenta_admin"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>